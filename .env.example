# ============================================================================
#  ПОЛКА — настройки магазина.
#  Скопируйте файл в .env и заполните своими значениями:
#      cp .env.example .env
#  Файл .env не попадает в git (см. .gitignore).
# ============================================================================

# --- магазин ---
SHOP_NAME=ПОЛКА
SHOP_URL=https://ваш-домен.ru      # нужен для возврата после оплаты и для вебхуков
PORT=8000

# --- админка (ОБЯЗАТЕЛЬНО смените!) ---
ADMIN_PASSWORD=admin123

# --- продавец: печатается в чеке и в подвале сайта ---
SELLER_NAME=ИП Иванов Иван Иванович
SELLER_INN=000000000000
SELLER_EMAIL=orders@example.ru
SELLER_PHONE=+7 900 000-00-00

# ============================================================================
#  ДОСТАВКА — Ozon
#  OZON_MODE=demo  — работает сразу, считает по тарифу из настроек ниже
#  OZON_MODE=api   — реальные запросы в Ozon Seller API (нужны Client-Id и Api-Key)
# ============================================================================
OZON_MODE=demo
OZON_CLIENT_ID=
OZON_API_KEY=

# тариф для demo-режима
DELIVERY_BASE=199
DELIVERY_PER_KG=39
DELIVERY_FREE_FROM=3433
DELIVERY_MAX_DAYS=7

# ============================================================================
#  ОПЛАТА И ЧЕК (54-ФЗ)
#  PAYMENT_PROVIDER: demo | yookassa | cloudpayments | robokassa
# ============================================================================
PAYMENT_PROVIDER=demo

# --- ЮKassa: https://yookassa.ru → Интеграция → Ключи API ---
# В личном кабинете включите «Онлайн-касса» — ЮKassa сама пробьёт чек по данным из платежа.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- CloudPayments: https://cloudpayments.ru ---
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=

# --- Robokassa ---
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=

# --- параметры чека ---
VAT_CODE=1          # 1 — без НДС (УСН), 3 — НДС 20%, 2 — НДС 10%
SNO=usn_income      # osn | usn_income | usn_income_outcome | esn | patent

# --- отдельная облачная касса (если не встроенная в платёжный сервис) ---
FISCAL_PROVIDER=    # "" | atol | orangedata | modulkassa
FISCAL_TOKEN=
FISCAL_GROUP_ID=
